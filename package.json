{
	"name": "angular-context-graph",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"angular-context-graph": "src/cli.mjs"
	},
	"engines": {
		"node": ">=22.23.0"
	},
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"test:matrix": "node scripts/test-matrix.mjs",
		"demo": "node src/cli.mjs --project fixtures/tsconfig.json --component FooComponent",
		"demo:index": "node src/cli.mjs index --project fixtures/core-relations/tsconfig.json",
		"mcp": "node src/cli.mjs mcp",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@angular/common": "22.2.1",
		"@angular/compiler": "22.2.1",
		"@angular/compiler-cli": "22.2.1",
		"@angular/core": "22.2.1",
		"@angular/forms": "22.2.1",
		"@angular/platform-browser": "22.2.1",
		"@angular/router": "22.2.1",
		"prettier": "^3.9.9",
		"rxjs": "^7.8.2",
		"typescript": "~6.0.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"zod": "^4.6.5"
	}
}
